NODE_ENV=development
PORT=5000

# MongoDB - Update this to match your MongoDB setup
MONGO_URI=mongodb://localhost:27017/safoua-academy

# JWT Secrets - Use these for development
JWT_SECRET=safoua_academy_jwt_secret_key_2024_development
JWT_REFRESH_SECRET=safoua_academy_refresh_secret_key_2024_development
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Email Configuration (Optional - for password reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=noreply@safouaacademy.com

# Cloudinary (Optional - for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits (in bytes)
MAX_FILE_SIZE=52428800
MAX_VIDEO_SIZE=524288000
MAX_AUDIO_SIZE=104857600